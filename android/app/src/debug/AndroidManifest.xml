<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.madoverbuildings.app">
    <!-- Flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds talk to the local Django dev server over plain http
         (http://10.0.2.2:8000 from an emulator). Android blocks cleartext by
         default from API 28; release builds keep that protection. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
